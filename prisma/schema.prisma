generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Employee {
  employee_code      Int              @id
  employee_name      String
  department         String?
  job_title          String?
  company            String?
  hiring_date        DateTime?
  national_id        BigInt?
  birth_date         DateTime?
  email              String?
  mobile             String?
  manager            String?
  status             String           @default("Active")
  termination_date   DateTime?
  termination_reason String?
  age                Int?
  created_at         DateTime         @default(now())
  updated_at         DateTime         @updatedAt

  contracts          Contract[]
  renewal_requests   RenewalRequest[]
  app_users          AppUser[]

  @@map("employees")
}

model Contract {
  contract_id         String    @id @default(uuid())
  employee_code       Int
  contract_type       String    @default("محدد المدة")
  contract_start_date DateTime?
  contract_end_date   DateTime?
  status              String    @default("Active")
  created_at          DateTime  @default(now())
  updated_at          DateTime  @updatedAt

  employee            Employee  @relation(fields: [employee_code], references: [employee_code], onDelete: Cascade)

  @@map("contracts")
}

model RenewalRequest {
  request_id            String    @id
  contract_id           String?
  employee_code         Int
  employee_name         String?
  department            String?
  job_title             String?
  company               String?
  contract_type         String?
  contract_end_date     DateTime?
  new_contract_end_date DateTime?
  renewal_months        Float?
  status                String    @default("Pending")
  signature_status      String    @default("قيد التوقيع")
  request_date          DateTime? @default(now())
  decision_date         DateTime?
  decision_by           String?
  decision_notes        String?
  created_at            DateTime  @default(now())
  updated_at            DateTime  @updatedAt

  employee              Employee  @relation(fields: [employee_code], references: [employee_code], onDelete: Cascade)

  @@map("renewal_requests")
}

model AppUser {
  user_id       String   @id @default(uuid())
  employee_code Int
  username      String   @unique
  password      String
  role          String   @default("HR")
  created_at    DateTime @default(now())

  employee      Employee @relation(fields: [employee_code], references: [employee_code], onDelete: Cascade)

  @@map("app_users")
}

model Setting {
  setting_key   String   @id
  setting_value String
  description   String?
  active        Boolean  @default(true)
  updated_at    DateTime @updatedAt

  @@map("settings")
}
